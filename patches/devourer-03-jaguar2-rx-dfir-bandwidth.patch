+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+#include <cstdint>
+
+namespace jaguar2 {
+// Vendor phydm_rxdfirpar_by_bw_8822b: narrowband shares the 20 MHz filter.
+template <typename Device>
+void set_rx_dfir_8822b(Device &device, uint8_t bw) {
+  const bool wide = bw == 1 || bw == 2; // CHANNEL_WIDTH_40 / _80
+  device.phy_set_bb_reg(0x0948, (1u << 29) | (1u << 28), bw == 1 ? 1 : 2);
+  device.phy_set_bb_reg(0x094c, (1u << 29) | (1u << 28), bw == 1 ? 0 : bw == 2 ? 1 : 2);
+  device.phy_set_bb_reg(0x0c20, 1u << 31, wide ? 0 : 1);
+  device.phy_set_bb_reg(0x0e20, 1u << 31, wide ? 0 : 1);
+}
+} // namespace jaguar2
